// NOT DEPLOYED.
//
// Nothing in Tabang writes to Firebase Storage. Uploads go to Cloudinary,
// chosen so the project could stay on the free plan. Firebase Storage is not
// enabled on the project, and listing it in firebase.json made every deploy
// fail on a service the app does not use.
//
// This file and its emulator tests are kept because the decision could be
// reversed: if Storage is ever enabled, these are the rules to deploy, and
// they are already tested. Re-add the "storage" block to firebase.json at
// that point.
//
// Note the gap if that happens: these rules read roles from a custom claim,
// because Storage Rules cannot read Firestore. Nothing currently sets that
// claim, so every role check here would deny until a trusted process does.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    // Storage Rules cannot read Firestore, so elevated roles must arrive as a
    // custom claim here even though Firestore resolves roles from
    // roleAssignments/{uid}. Owner-scoped access below does not depend on roles.
    function hasRole(role) {
      return isSignedIn() && request.auth.token.role == role;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isReviewer() {
      return hasRole('reviewer') || isAdmin();
    }

    function isTrustedResponder() {
      return hasRole('responder') || isReviewer();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /responderApplications/{userId}/{allPaths=**} {
      allow read, write: if isOwner(userId) || isReviewer();
    }

    match /reportUploads/{userId}/{allPaths=**} {
      allow read: if isOwner(userId) || isTrustedResponder();
      allow write: if isOwner(userId) || isReviewer();
    }

    match /publicFeed/{allPaths=**} {
      allow read: if true;
      allow write: if isTrustedResponder();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
