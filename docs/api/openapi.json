{
  "openapi": "3.1.0",
  "info": {
    "title": "Tabang API",
    "version": "1.0.0",
    "description": "Versioned API for partner systems such as DOST Signal. Every error uses the same envelope, and every response carries an X-Request-Id header."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "Partner key of the form tbk_<client id>_<secret>, issued by a Tabang operator. Only its hash is stored."
      }
    },
    "headers": {
      "X-Request-Id": {
        "description": "Identifies this request in Tabang's logs; quote it when reporting a problem.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message",
              "requestId"
            ],
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "invalid_request",
                  "unauthorized",
                  "forbidden",
                  "not_found",
                  "method_not_allowed",
                  "rate_limited",
                  "not_implemented",
                  "unavailable",
                  "internal"
                ]
              },
              "message": {
                "type": "string"
              },
              "requestId": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "time"
        ],
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "time": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PartnerIncident": {
        "type": "object",
        "description": "The only incident fields shared with partners (decision D-5). Contact numbers, descriptions, exact locations, landmarks, photos, and reporter ids are never included.",
        "required": [
          "id",
          "kind",
          "incidentStatus",
          "verificationStatus",
          "severity",
          "need",
          "peopleAffected",
          "municipality",
          "barangay",
          "createdAt",
          "updatedAt",
          "acknowledgedAt",
          "resolvedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "flood",
              "help"
            ]
          },
          "incidentStatus": {
            "type": "string",
            "enum": [
              "new",
              "acknowledged",
              "dispatched",
              "on_scene",
              "resolved",
              "cancelled"
            ]
          },
          "verificationStatus": {
            "type": "string",
            "enum": [
              "pending",
              "verified",
              "rejected"
            ]
          },
          "severity": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "ankle",
              "knee",
              "waist",
              "chest",
              "above-head",
              null
            ]
          },
          "need": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "rescue",
              "medical",
              "food-water",
              "shelter",
              "other",
              null
            ]
          },
          "peopleAffected": {
            "type": [
              "integer",
              "null"
            ]
          },
          "municipality": {
            "type": "string"
          },
          "barangay": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "acknowledgedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "resolvedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Advisory": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "summary",
          "municipality",
          "barangay",
          "source",
          "createdAt",
          "expiresAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "flood",
              "help",
              "advisory"
            ]
          },
          "summary": {
            "type": "string",
            "maxLength": 240
          },
          "municipality": {
            "type": [
              "string",
              "null"
            ]
          },
          "barangay": {
            "type": [
              "string",
              "null"
            ]
          },
          "source": {
            "type": "string",
            "description": "tabang for a responder's advisory, or the partner source of a signal."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "Signal": {
        "type": "object",
        "description": "The canonical inbound hazard signal. Idempotent by source and externalId.",
        "required": [
          "source",
          "externalId",
          "type",
          "headline",
          "areas",
          "issuedAt"
        ],
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "externalId": {
            "type": "string",
            "maxLength": 128
          },
          "type": {
            "type": "string",
            "enum": [
              "tropical-cyclone-wind-signal",
              "rainfall-warning",
              "flood-advisory",
              "other"
            ]
          },
          "level": {
            "type": "string",
            "maxLength": 32
          },
          "headline": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "body": {
            "type": "string",
            "maxLength": 2000
          },
          "areas": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "object",
              "required": [
                "municipality"
              ],
              "properties": {
                "municipality": {
                  "type": "string",
                  "description": "One of the 17 Aklan municipalities."
                },
                "barangay": {
                  "type": "string",
                  "maxLength": 80
                }
              }
            }
          },
          "issuedAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 with an offset."
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "After this, the advisory stops showing."
          },
          "url": {
            "type": "string",
            "pattern": "^https://",
            "maxLength": 2048
          }
        }
      },
      "SignalResult": {
        "type": "object",
        "required": [
          "data"
        ],
        "properties": {
          "data": {
            "type": "object",
            "required": [
              "id",
              "created"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "created": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "responses": {
      "Error": {
        "description": "An error in the standard envelope.",
        "headers": {
          "X-Request-Id": {
            "$ref": "#/components/headers/X-Request-Id"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "parameters": {
      "limit": {
        "name": "limit",
        "in": "query",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      },
      "cursor": {
        "name": "cursor",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "The nextCursor from the previous page."
      }
    }
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Liveness check. Does not touch the database.",
        "security": [],
        "responses": {
          "200": {
            "description": "The server is running.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "429": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/advisories": {
      "get": {
        "operationId": "listAdvisories",
        "summary": "Published, unexpired advisories, newest first, including those from partner signals. Readable from any website.",
        "security": [],
        "parameters": [
          {
            "$ref": "#/components/parameters/limit"
          },
          {
            "$ref": "#/components/parameters/cursor"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of advisories.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "nextCursor"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Advisory"
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Pass as cursor for the next page; null at the end."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/incidents": {
      "get": {
        "operationId": "listIncidents",
        "summary": "Incidents in the partner projection, ordered by last change then id.",
        "security": [
          {
            "apiKey": [
              "incidents:read"
            ]
          }
        ],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "open",
                "new",
                "acknowledged",
                "dispatched",
                "on_scene",
                "resolved",
                "cancelled"
              ],
              "default": "open"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "flood",
                "help"
              ]
            }
          },
          {
            "name": "municipality",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Only incidents changed at or after this time."
          },
          {
            "$ref": "#/components/parameters/limit"
          },
          {
            "$ref": "#/components/parameters/cursor"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of incidents.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "nextCursor"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/PartnerIncident"
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ],
                      "description": "Pass as cursor for the next page; null at the end."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/incidents/{id}": {
      "get": {
        "operationId": "getIncident",
        "summary": "One incident in the partner projection.",
        "security": [
          {
            "apiKey": [
              "incidents:read"
            ]
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The incident.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/PartnerIncident"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "404": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/signals": {
      "post": {
        "operationId": "sendSignal",
        "summary": "Send a hazard signal. Tabang publishes it as an advisory until expiresAt. Resending the same source and externalId updates it.",
        "security": [
          {
            "apiKey": [
              "signals:write"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Signal"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "An existing signal was updated.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignalResult"
                }
              }
            }
          },
          "201": {
            "description": "A new signal was published.",
            "headers": {
              "X-Request-Id": {
                "$ref": "#/components/headers/X-Request-Id"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignalResult"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error"
          },
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "413": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "503": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    },
    "/api/v1/integrations/dost-signal": {
      "post": {
        "operationId": "sendDostSignal",
        "summary": "Reserved for DOST Signal's own payload. Answers 501 until the contract is agreed; use /api/v1/signals meanwhile.",
        "security": [
          {
            "apiKey": [
              "signals:write"
            ]
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          }
        },
        "responses": {
          "401": {
            "$ref": "#/components/responses/Error"
          },
          "403": {
            "$ref": "#/components/responses/Error"
          },
          "429": {
            "$ref": "#/components/responses/Error"
          },
          "501": {
            "$ref": "#/components/responses/Error"
          }
        }
      }
    }
  }
}
