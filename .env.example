# Project Tabang Environment Configuration
# Copy this file to .env for local development: cp .env.example .env

# Server network binding
HOST=127.0.0.1
PORT=8000

# Supabase (the browser uses only the URL and publishable key).
# Fill these from `npm run supabase:status` for local development.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=http://127.0.0.1:54321
# Server only. Never prefix this with VITE_ or expose it to the browser.
SUPABASE_SECRET_KEY=

# PostgreSQL database connection string
# Transitional Render app API only. Removed after the Supabase app checks pass.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/tabang

# Directory for file storage (report photos and responder evidence)
# Transitional Render app API only. New app uploads go to private Supabase Storage.
UPLOAD_DIR=uploads

# Application origin used for CSRF origin validation and password reset links
# Transitional Render app API only.
APP_ORIGIN=http://127.0.0.1:8000

# Email provider configuration (HTTP email API e.g. Resend)
# Transitional Render app API only. Supabase Auth sends password reset email.
EMAIL_API_KEY=
EMAIL_FROM=

# Rate limiting: requests per minute per partner API key and per IP on public routes
API_RATE_LIMIT_PER_MINUTE=60
