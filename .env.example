# Project Tabang Environment Configuration
# Copy this file to .env for local development: cp .env.example .env

# Server network binding
HOST=127.0.0.1
PORT=8000

# PostgreSQL database connection string
# Local default connects to the Docker Compose service (compose.yaml on port 54329)
# On Render, this is injected automatically from the database service via render.yaml
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/tabang

# Directory for file storage (report photos and responder evidence)
# Local: relative folder 'uploads'
# Render Free: 'uploads' (stored on container filesystem; lost on sleep/restart)
# Render Paid: '/var/data/uploads' (mounted persistent disk)
UPLOAD_DIR=uploads

# Application origin used for CSRF origin validation and password reset links
# Local: http://127.0.0.1:8000
# Render: https://your-service-name.onrender.com
APP_ORIGIN=http://127.0.0.1:8000

# Email provider configuration (HTTP email API e.g. Resend)
# When EMAIL_API_KEY is unset in non-production, password reset links log to console
EMAIL_API_KEY=
EMAIL_FROM=

# Rate limiting: requests per minute per partner API key and per IP on public routes
API_RATE_LIMIT_PER_MINUTE=60
