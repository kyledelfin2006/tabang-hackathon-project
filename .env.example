HOST=127.0.0.1
PORT=8000
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_USE_FIREBASE_EMULATORS=false
VITE_FIREBASE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
VITE_FIRESTORE_EMULATOR_HOST=127.0.0.1
VITE_FIRESTORE_EMULATOR_PORT=18085
VITE_STORAGE_EMULATOR_HOST=127.0.0.1
VITE_STORAGE_EMULATOR_PORT=19195
# Server-side only. These are read by server.mjs to sign uploads and must
# never be exposed to the browser, so they carry no VITE_ prefix.
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# Used to verify Firebase ID tokens before issuing an upload signature.
FIREBASE_WEB_API_KEY=your_firebase_web_api_key
