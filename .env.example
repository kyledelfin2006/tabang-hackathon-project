HOST=127.0.0.1
PORT=8000
# Supabase. Locally, copy the values printed by `npx supabase status`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_URL=http://127.0.0.1:54321
# Server only: bypasses row-level security. Never give it a VITE_ prefix.
SUPABASE_SECRET_KEY=your_supabase_secret_key
# Requests per minute per partner key, and per address for public routes.
API_RATE_LIMIT_PER_MINUTE=60
