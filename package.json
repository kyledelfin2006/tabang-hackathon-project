{
  "name": "project_tabang",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js",
    "build": "npm run check:env && node ./node_modules/vite/bin/vite.js build",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "lint": "node ./node_modules/eslint/bin/eslint.js src server scripts tests vite.config.js eslint.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node ./node_modules/vitest/vitest.mjs run src/test",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "scan:secrets": "node scripts/security/scan-secrets.mjs",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "check": "npm run lint && npm run scan:secrets && npm run check:contrast && npm run test:unit && npm run test:server && npm run build",
    "test:server": "node --test \"tests/server/**/*.test.mjs\"",
    "test:policies": "node --test --test-concurrency=1 \"tests/policies/**/*.test.mjs\"",
    "check:contrast": "node ./scripts/a11y/check-contrast.mjs",
    "check:env": "node ./scripts/build/check-env.mjs",
    "db:start": "docker compose up -d --wait",
    "db:stop": "docker compose down",
    "db:migrate": "node --env-file-if-exists=.env server/db/migrate.mjs",
    "db:reset": "node --env-file-if-exists=.env server/db/reset.mjs",
    "test:integration": "node --env-file-if-exists=.env --test --test-concurrency=1 \"tests/integration/**/*.test.mjs\"",
    "api-clients": "node --env-file-if-exists=.env scripts/api-clients.mjs",
    "seed:hotlines": "node --env-file-if-exists=.env scripts/seed-hotlines.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "supabase": "^2.121.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
